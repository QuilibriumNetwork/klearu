{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Klearu",
  "version": "0.2.0",
  "identifier": "io.quilibrium.klearu",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Klearu",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/.klearu/**",
          "$HOME/.klearu/images/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Klearu: private LLM + image gen + training",
    "longDescription": "Local-first chat, image generation, inpainting, classification, and training on top of the Klearu Rust stack."
  }
}
